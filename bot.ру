import requests
import telebot
import time

BOT_TOKEN = "8675697894:AAGp3nxKHHq62TNQm8qkvYghb3ijEGYiW04"
YOUR_CHAT_ID = "8142623149"

bot = telebot.TeleBot(BOT_TOKEN)

@bot.message_handler(commands=['start'])
def start(message):
    if str(message.chat.id) == YOUR_CHAT_ID:
        bot.send_message(
            message.chat.id,
            "👋 Привет, Baton!\n\nОтправь мне любой текст, и я нарисую картинку.\n\nПримеры:\n- Кот в космосе\n- Город будущего\n- Девушка в стиле аниме"
        )

@bot.message_handler(func=lambda message: True)
def generate_image(message):
    if str(message.chat.id) != YOUR_CHAT_ID:
        bot.send_message(message.chat.id, "❌ Этот бот только для личного использования.")
        return
    
    prompt = message.text
    msg = bot.send_message(message.chat.id, "🎨 Рисую... подожди 15-20 секунд")
    
    try:
        url = f"https://pollinations.ai/p/{prompt}?width=1024&height=1024&nologo=true&seed={int(time.time())}"
        response = requests.get(url, timeout=45)
        
        if response.status_code == 200:
            bot.delete_message(message.chat.id, msg.message_id)
            bot.send_photo(
                message.chat.id,
                response.content,
                caption=f"✅ Готово!\n\nЗапрос: {prompt}"
            )
        else:
            bot.edit_message_text(
                f"❌ Ошибка (код {response.status_code}). Попробуй позже.",
                message.chat.id,
                msg.message_id
            )
    
    except Exception as e:
        bot.edit_message_text(f"⚠️ Ошибка: {str(e)[:80]}", message.chat.id, msg.message_id)

if __name__ == "__main__":
    print("🤖 Бот запущен!")
    bot.infinity_polling()
